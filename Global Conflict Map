import React, { useState, useEffect, useRef } from 'react';
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
import { 
  ShieldAlert, 
  Globe, 
  TrendingUp, 
  AlertTriangle,
  Info,
  X,
  CheckCircle2,
  Navigation2,
  HeartPulse,
  Zap,
  RefreshCcw,
  Search as SearchIcon
} from 'lucide-react';

const apiKey = ""; // API Key được môi trường cung cấp tự động

const ThreeGlobe = ({ onSelectZone, zones }) => {
  const mountRef = useRef(null);
  const sceneRef = useRef(null);
  const markersRef = useRef(null);

  useEffect(() => {
    if (!mountRef.current) return;

    const width = mountRef.current.clientWidth;
    const height = mountRef.current.clientHeight;
    const scene = new THREE.Scene();
    sceneRef.current = scene;
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 240;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(window.devicePixelRatio);
    mountRef.current.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.rotateSpeed = 0.5;
    controls.minDistance = 120;
    controls.maxDistance = 400;

    const textureLoader = new THREE.TextureLoader();
    const earthMap = textureLoader.load('https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg');
    const bumpMap = textureLoader.load('https://unpkg.com/three-globe/example/img/earth-topology.png');
    const specMap = textureLoader.load('https://unpkg.com/three-globe/example/img/earth-waterbodies.png');

    const earthGeo = new THREE.SphereGeometry(100, 64, 64);
    const earthMat = new THREE.MeshPhongMaterial({
      map: earthMap,
      bumpMap: bumpMap,
      bumpScale: 2.0,
      specularMap: specMap,
      specular: new THREE.Color('grey'),
      shininess: 10,
    });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    scene.add(earth);

    const cloudGeo = new THREE.SphereGeometry(101.5, 64, 64);
    const cloudTexture = textureLoader.load('https://unpkg.com/three-globe/example/img/earth-clouds.png');
    const cloudMat = new THREE.MeshPhongMaterial({
      map: cloudTexture,
      transparent: true,
      opacity: 0.35,
      blending: THREE.AdditiveBlending
    });
    const clouds = new THREE.Mesh(cloudGeo, cloudMat);
    scene.add(clouds);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);
    const sunLight = new THREE.DirectionalLight(0xffffff, 1.2);
    sunLight.position.set(5, 3, 5);
    scene.add(sunLight);

    const markers = new THREE.Group();
    markersRef.current = markers;
    scene.add(markers);

    const animate = () => {
      requestAnimationFrame(animate);
      earth.rotation.y += 0.0004;
      clouds.rotation.y += 0.0006;
      markers.rotation.y += 0.0004;
      
      const time = Date.now() * 0.005;
      markers.children.forEach(m => {
        if (m.geometry.type === 'RingGeometry') {
          const s = 1 + Math.sin(time) * 0.35;
          m.scale.set(s, s, 1);
          m.material.opacity = 0.7 - (s - 1);
        }
      });

      controls.update();
      renderer.render(scene, camera);
    };
    animate();

    const onMouseClick = (event) => {
      const rect = renderer.domElement.getBoundingClientRect();
      const mouse = new THREE.Vector2(
        ((event.clientX - rect.left) / width) * 2 - 1,
        -((event.clientY - rect.top) / height) * 2 + 1
      );
      const raycaster = new THREE.Raycaster();
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(markers.children);
      if (intersects.length > 0) {
        const target = intersects.find(i => i.object.userData.id);
        if (target) onSelectZone(target.object.userData);
      }
    };

    renderer.domElement.addEventListener('mousedown', onMouseClick);

    const handleResize = () => {
      const w = mountRef.current.clientWidth;
      const h = mountRef.current.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener('resize', handleResize);

    return () => {
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      renderer.domElement?.removeEventListener('mousedown', onMouseClick);
      mountRef.current?.removeChild(renderer.domElement);
    };
  }, []);

  // Update markers when zones change
  useEffect(() => {
    if (!markersRef.current) return;
    const markers = markersRef.current;
    markers.clear();

    const latLngToVector3 = (lat, lng, radius) => {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lng + 180) * (Math.PI / 180);
      return new THREE.Vector3(
        -(radius * Math.sin(phi) * Math.cos(theta)),
        radius * Math.cos(phi),
        radius * Math.sin(phi) * Math.sin(theta)
      );
    };

    zones.forEach(zone => {
      const pos = latLngToVector3(zone.lat, zone.lng, 102);
      const color = zone.status === 'red' ? 0xff3333 : 0x00ff88;
      
      const pin = new THREE.Mesh(
        new THREE.SphereGeometry(1.5, 16, 16),
        new THREE.MeshBasicMaterial({ color: color })
      );
      pin.position.copy(pos);
      pin.userData = zone;
      markers.add(pin);

      const ring = new THREE.Mesh(
        new THREE.RingGeometry(2.5, 4.0, 32),
        new THREE.MeshBasicMaterial({ color: color, side: THREE.DoubleSide, transparent: true, opacity: 0.7 })
      );
      ring.position.copy(pos);
      ring.lookAt(new THREE.Vector3(0,0,0));
      markers.add(ring);
    });
  }, [zones]);

  return <div ref={mountRef} className="w-full h-full cursor-grab active:cursor-grabbing" />;
};

export default function App() {
  const [selectedZone, setSelectedZone] = useState(null);
  const [newsFeed, setNewsFeed] = useState([]);
  const [zones, setZones] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  const fetchLiveIntel = async (retryCount = 0) => {
    setLoading(true);
    setError(null);
    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: "Hãy tìm kiếm các tin tức nóng hổi nhất về xung đột quân sự, tình hình biên giới và an ninh quốc tế từ CNN, BBC và Reuters trong 24 giờ qua. Sau đó trả về kết quả dưới dạng JSON có cấu trúc gồm: 'news' (mảng các tin tức: title, source, time, summary) và 'zones' (mảng các vùng xung đột: country, status ('red' hoặc 'green'), lat, lng, detail, advisory, evacuation, source, accuracy)." }] }],
          tools: [{ "google_search": {} }],
          generationConfig: { responseMimeType: "application/json" }
        })
      });

      if (!response.ok) throw new Error('Network error');
      
      const result = await response.json();
      const data = JSON.parse(result.candidates?.[0]?.content?.parts?.[0]?.text || "{}");
      
      if (data.news) setNewsFeed(data.news);
      if (data.zones) setZones(data.zones);
      
    } catch (err) {
      if (retryCount < 5) {
        const delay = Math.pow(2, retryCount) * 1000;
        setTimeout(() => fetchLiveIntel(retryCount + 1), delay);
      } else {
        setError("Không thể kết nối với trung tâm dữ liệu. Vui lòng thử lại sau.");
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchLiveIntel();
    const interval = setInterval(fetchLiveIntel, 300000); // Tự động cập nhật mỗi 5 phút
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="flex flex-col h-screen bg-[#010103] text-slate-300 font-sans overflow-hidden">
      <style>{`
        @keyframes scan { 0% { top: 0% } 100% { top: 100% } }
        .scanning-line { animation: scan 4s linear infinite; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        .glow-text { text-shadow: 0 0 10px rgba(59, 130, 246, 0.5); }
        .earth-glass { background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }
      `}</style>

      {/* Header */}
      <header className="h-14 flex items-center justify-between px-6 bg-black/90 border-b border-white/5 z-50">
        <div className="flex items-center gap-4">
          <div className="p-1.5 bg-blue-500/10 border border-blue-500/30 rounded shadow-[0_0_15px_rgba(59,130,246,0.1)]">
            <Globe size={18} className="text-blue-400" />
          </div>
          <div>
            <h1 className="text-xs font-black tracking-[0.2em] text-white uppercase italic glow-text">SATELLITE <span className="text-blue-500">INTEL</span> LIVE</h1>
            <div className="flex items-center gap-2 mt-0.5">
              <span className={`w-1.5 h-1.5 rounded-full ${loading ? 'bg-blue-500 animate-spin' : 'bg-emerald-500'} animate-pulse`}></span>
              <span className="text-[8px] font-bold text-slate-500 uppercase tracking-widest italic">
                {loading ? 'Đang đồng bộ dữ liệu CNN/BBC...' : 'Live Feed: Kết nối trực tiếp vệ tinh'}
              </span>
            </div>
          </div>
        </div>
        
        <div className="flex gap-3">
           <button 
             onClick={() => fetchLiveIntel()} 
             disabled={loading}
             className="px-3 py-1 bg-white/5 hover:bg-white/10 rounded border border-white/5 flex items-center gap-2 transition-all active:scale-95 disabled:opacity-50"
           >
              <RefreshCcw size={12} className={loading ? "animate-spin text-blue-400" : "text-slate-400"} />
              <span className="text-[9px] font-black uppercase text-slate-400">Làm mới dữ liệu</span>
           </button>
        </div>
      </header>

      {/* Main Content */}
      <main className="flex-1 flex overflow-hidden p-2 gap-2 flex-col lg:flex-row">
        
        {/* Left Bar: Live News Feed */}
        <div className="w-full lg:w-80 bg-[#050508]/60 border border-white/5 rounded-lg flex flex-col overflow-hidden backdrop-blur-md">
           <div className="p-3 border-b border-white/5 bg-white/[0.02] flex items-center justify-between">
              <span className="text-[9px] font-black uppercase tracking-widest text-blue-400 flex items-center gap-2">
                <TrendingUp size={12} /> Tin tức trực tuyến
              </span>
           </div>
           <div className="flex-1 overflow-y-auto p-2 space-y-2 custom-scrollbar">
              {newsFeed.length > 0 ? newsFeed.map((news, idx) => (
                <div key={idx} className="p-3 bg-white/[0.02] border border-white/5 rounded-lg hover:bg-white/[0.05] transition-all cursor-pointer group animate-in fade-in slide-in-from-left-4" style={{animationDelay: `${idx * 50}ms`}}>
                  <div className="flex justify-between items-center mb-1">
                    <span className="text-[8px] font-black text-blue-400 uppercase bg-blue-500/10 px-1.5 py-0.5 rounded">{news.source}</span>
                    <span className="text-[8px] text-slate-600 font-mono italic">{news.time}</span>
                  </div>
                  <h3 className="text-[10px] font-bold text-slate-200 leading-snug group-hover:text-white line-clamp-2">{news.title}</h3>
                  <p className="text-[9px] text-slate-500 mt-2 line-clamp-2 leading-relaxed italic">{news.summary}</p>
                </div>
              )) : (
                <div className="h-full flex flex-col items-center justify-center text-slate-600 p-8 text-center">
                  <SearchIcon size={24} className="mb-4 opacity-20 animate-bounce" />
                  <p className="text-[10px] font-bold uppercase tracking-widest italic">Đang quét hạ tầng mạng quốc tế...</p>
                </div>
              )}
           </div>
        </div>

        {/* 3D Map - Center */}
        <div className="flex-1 relative bg-[#000000] border border-white/5 rounded-lg overflow-hidden shadow-2xl">
          {error && (
            <div className="absolute top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2 bg-red-900/80 border border-red-500 text-red-200 text-[10px] font-bold rounded-full backdrop-blur-md flex items-center gap-2">
              <AlertTriangle size={14} /> {error}
            </div>
          )}

          {/* Tactical HUD Overlay */}
          <div className="absolute inset-0 pointer-events-none z-10 p-6">
             <div className="absolute top-6 left-6 p-4 earth-glass rounded-xl max-w-[240px] pointer-events-auto">
                <div className="flex items-center gap-2 text-blue-400 mb-2">
                  <Zap size={14} className="fill-blue-400" />
                  <span className="text-[10px] font-black uppercase tracking-widest italic">Hệ thống phân tích tin tức</span>
                </div>
                <p className="text-[10px] text-slate-400 font-medium leading-relaxed italic">
                  Dữ liệu được nạp trực tiếp từ các hãng thông tấn BBC, CNN thông qua Google Search AI Grounding.
                </p>
                <div className="mt-4 pt-3 border-t border-white/5 grid grid-cols-2 gap-2">
                   <div>
                     <p className="text-[7px] text-slate-600 font-black uppercase italic">Nguồn cấp</p>
                     <p className="text-[9px] text-blue-400 font-black uppercase">LIVE SEARCH</p>
                   </div>
                   <div>
                     <p className="text-[7px] text-slate-600 font-black uppercase italic">Số điểm nóng</p>
                     <p className="text-[9px] text-red-500 font-black uppercase">{zones.length} AREAS</p>
                   </div>
                </div>
             </div>

             <div className="absolute bottom-6 left-6 flex items-center gap-4 pointer-events-auto earth-glass px-4 py-2 rounded-lg border border-white/5">
                <div className="text-center">
                  <p className="text-[7px] text-slate-500 font-black uppercase">Vĩ độ</p>
                  <p className="text-[10px] font-mono text-white tracking-widest">REALTIME</p>
                </div>
                <div className="w-[1px] h-6 bg-white/10"></div>
                <div className="text-center text-blue-400">
                  <p className="text-[7px] text-slate-500 font-black uppercase italic">Dữ liệu mây</p>
                  <p className="text-[10px] font-mono tracking-widest uppercase">DYNAMIC</p>
                </div>
             </div>
          </div>

          <ThreeGlobe onSelectZone={setSelectedZone} zones={zones} />

          {/* Info Sidebar */}
          {selectedZone && (
            <div className="absolute top-4 right-4 bottom-4 w-85 bg-black/95 backdrop-blur-3xl border border-white/10 rounded-2xl flex flex-col overflow-hidden shadow-2xl z-30 animate-in fade-in slide-in-from-right-8 ring-1 ring-white/10">
              <div className="p-6 border-b border-white/10 flex justify-between items-start bg-gradient-to-br from-blue-500/10 to-transparent">
                <div>
                   <div className="flex items-center gap-2 mb-2">
                      <span className={`px-2.5 py-0.5 rounded-full text-[8px] font-black text-white uppercase tracking-tighter ${selectedZone.status === 'red' ? 'bg-red-600 shadow-[0_0_15px_rgba(220,38,38,0.4)]' : 'bg-emerald-600 shadow-[0_0_15px_rgba(16,185,129,0.4)]'}`}>
                        {selectedZone.status === 'red' ? 'XUNG ĐỘT' : 'ỔN ĐỊNH'}
                      </span>
                      <span className="text-[9px] font-bold text-slate-500 uppercase tracking-widest">
                        Độ chính xác: {selectedZone.accuracy || '95%'}
                      </span>
                   </div>
                   <h2 className="text-3xl font-black text-white tracking-tighter uppercase italic glow-text">{selectedZone.country}</h2>
                </div>
                <button onClick={() => setSelectedZone(null)} className="p-2 hover:bg-white/10 rounded-full text-slate-500 transition-all active:scale-90">
                  <X size={24} />
                </button>
              </div>

              <div className="flex-1 overflow-y-auto p-6 space-y-6 custom-scrollbar">
                <section>
                  <h4 className="text-[10px] font-black text-blue-400 uppercase tracking-widest mb-3 flex items-center gap-2 border-l-2 border-blue-500 pl-3 italic">
                    <Info size={14} /> Chi tiết tình hình
                  </h4>
                  <div className="bg-white/[0.03] p-4 rounded-xl border border-white/5">
                    <p className="text-[13px] text-slate-300 leading-relaxed font-medium italic">
                      "{selectedZone.detail}"
                    </p>
                  </div>
                  <p className="text-[9px] text-slate-600 mt-2 italic px-1 italic">Nguồn tin: <span className="text-blue-500/60 uppercase font-black">{selectedZone.source}</span></p>
                </section>

                <section className="bg-red-950/20 border border-red-500/20 p-5 rounded-2xl relative overflow-hidden">
                  <h4 className="text-[10px] font-black text-red-500 uppercase tracking-widest mb-3 flex items-center gap-2 italic">
                    <ShieldAlert size={14} /> Khuyến cáo an ninh
                  </h4>
                  <p className="text-[12px] text-red-100/80 leading-relaxed font-bold italic">
                    {selectedZone.advisory}
                  </p>
                </section>

                <section className="bg-blue-950/20 border border-blue-500/20 p-5 rounded-2xl">
                  <h4 className="text-[10px] font-black text-blue-400 uppercase tracking-widest mb-3 flex items-center gap-2 italic">
                    <Navigation2 size={14} /> Hướng dẫn sơ tán
                  </h4>
                  <p className="text-[12px] text-blue-100/80 leading-relaxed font-medium">
                    {selectedZone.evacuation}
                  </p>
                </section>
              </div>

              <div className="p-6 bg-black/40 border-t border-white/10 backdrop-blur-xl">
                <button className="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-[10px] font-black uppercase tracking-[0.25em] transition-all flex items-center justify-center gap-3 shadow-2xl shadow-blue-600/20 active:scale-[0.98]">
                  <HeartPulse size={18} /> Yêu cầu hỗ trợ khẩn cấp
                </button>
              </div>
            </div>
          )}
        </div>
      </main>

      {/* Footer Status */}
      <footer className="h-8 bg-black border-t border-white/5 flex items-center justify-between px-6 text-[8px] font-black text-slate-500 uppercase tracking-widest italic">
        <div className="flex gap-6">
          <span className="flex items-center gap-2 italic"><div className="w-1 h-1 rounded-full bg-blue-500 animate-pulse"></div> SAT-FEED: LIVE SEARCH ACTIVE</span>
          <span className="flex items-center gap-2 italic"><div className="w-1 h-1 rounded-full bg-emerald-500"></div> AI-GROUNDING: CNN/BBC SYNCED</span>
        </div>
        <div className="opacity-40 tracking-normal text-[7px] italic">© 2026 GLOBAL INTELLIGENCE MAPPING SYSTEM</div>
      </footer>
    </div>
  );
}
